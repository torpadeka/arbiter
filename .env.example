# Copy to .env and fill in. Never commit .env.

# --- HydraDB (local OSS node, started by scripts/hydradb_up.ps1) ---
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_BOLT_URI=neo4j://127.0.0.1:7687
HYDRA_TOKEN=local-development-token-32-bytes
HYDRA_NAMESPACE=default
HYDRA_GRAPH=default
HYDRA_CELL_ID=cell-0
# http = documented JSON contract (default, always works)
# bolt = neo4j driver fast path, validated by scripts/spike_hydra.py
HYDRA_TRANSPORT=http

# --- LLM (tier B extraction + answer rendering) ---
# Only these two steps use a model. Parsing, entity resolution, arbitration,
# traversal and abstention are all deterministic and need no key at all.
#
# provider: gemini | groq | cerebras | openrouter | openai | ollama | anthropic
# Gemini's free tier is the recommended default and enforces the JSON Schema
# server-side, which is what keeps the predicate vocabulary closed.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional overrides; each provider has a sensible default model.
LLM_MODEL=
EXTRACT_MODEL=
ANSWER_MODEL=
# LLM_BASE_URL=            # only needed for a self-hosted / proxy endpoint

# Free tiers rate-limit aggressively. Raise once you know your quota.
EXTRACT_CONCURRENCY=5

# --- Ingestion scope ---
# Tier A (deterministic field maps) always covers every document. This caps
# only the LLM pass over free text.
TIER_B_DOC_LIMIT=15000
